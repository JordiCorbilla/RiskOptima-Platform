RISKOPTIMA_PLATFORM_DATABASE_PATH=/opt/riskoptima-platform/data/riskoptima_platform.db
RISKOPTIMA_PLATFORM_GENERATED_DATA_PATH=/opt/riskoptima-platform/generated_data
RISKOPTIMA_PLATFORM_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://riskoptima.internal"]

# Optional: point the platform at a local RiskOptima checkout while developing the library.
# Leave unset in production to use the pinned PyPI package from requirements.txt.
# Dislocation Research currently requires the local 2.8.0 checkout.
# Copy this setting into a root .env and launch the API from the repository root.
# RISKOPTIMA_PLATFORM_RISKOPTIMA_PATH=C:/repo/portfolio_risk_kit
